# ---------------------------------------------------------------------------
# Pump.fun Bundle Detector — configuration
# Copy to .env and fill in.  NEVER commit a filled .env.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
# Comma-separated guild IDs for fast slash-command sync (empty = global sync)
DISCORD_GUILD_IDS=
# Channel where a bare mint address triggers an automatic scan (optional)
DISCORD_AUTOSCAN_CHANNEL_ID=
# Channel where /watch and /autoscan alerts are posted (optional)
DISCORD_ALERT_CHANNEL_ID=

# --- Solana RPC (required — this is the authoritative data source) ---------
# Any mainnet-beta RPC. A paid endpoint is strongly recommended: the public
# api.mainnet-beta.solana.com is heavily rate limited and lacks history.
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Optional secondary RPC used as automatic failover
RPC_URL_SECONDARY=

# --- Optional accelerators (the engine degrades gracefully without them) ---
HELIUS_API_KEY=
SOLSCAN_API_KEY=

# --- Storage ---------------------------------------------------------------
# PostgreSQL in production; the default falls back to a local SQLite file so
# the tool runs with zero infrastructure.
DATABASE_URL=sqlite+aiosqlite:///./pfbd.db
# DATABASE_URL=postgresql+asyncpg://pfbd:pfbd@localhost:5432/pfbd
REDIS_URL=redis://localhost:6379/0

# --- Engine tuning ---------------------------------------------------------
MAX_FUNDING_HOPS=3
FIRST_BUYERS_LIMIT=100
MAX_CONCURRENT_RPC=16
RPC_REQUESTS_PER_SECOND=25
HISTORY_MAX_SIGNATURES=1000
SCAN_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO

# --- Alert thresholds (0-100) ----------------------------------------------
ALERT_LOW_MAX=24
ALERT_MEDIUM_MAX=49
ALERT_HIGH_MAX=74
